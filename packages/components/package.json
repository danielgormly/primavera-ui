{
  "name": "@primavera-ui/components",
  "version": "0.0.2",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./otp": {
      "types": "./dist/otp/index.d.ts",
      "import": "./dist/otp.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "import": "./dist/dnd.js"
    },
    "./dnd/solid": {
      "types": "./dist/dnd/solid/index.d.ts",
      "import": "./dist/dnd-solid.js"
    },
    "./cal": {
      "types": "./dist/cal/index.d.ts",
      "import": "./dist/cal.js"
    }
  },
  "scripts": {
    "dev": "bun --bun x vite",
    "build": "bun --bun x vite build && bun --bun x tsc --emitDeclarationOnly",
    "start": "bun run dev",
    "watch": "bun --bun x vite build --watch",
    "preview": "bun --bun x vite preview"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "^2.0.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.12"
  }
}
